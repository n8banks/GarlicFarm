[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
macos.debug =            "res://../rust/target/debug/libgarlic_farm.dylib"
macos.release =          "res://../rust/target/release/libgarlic_farm.dylib"
macos.debug.arm64 =      "res://../rust/target/debug/libgarlic_farm.dylib"
macos.release.arm64 =    "res://../rust/target/release/libgarlic_farm.dylib"
linux.debug.x86_64 =     "res://../rust/target/debug/libgarlic_farm.so"
linux.release.x86_64 =   "res://../rust/target/release/libgarlic_farm.so"
windows.debug.x86_64 =   "res://../rust/target/debug/garlic_farm.dll"
windows.release.x86_64 = "res://../rust/target/release/garlic_farm.dll"
